rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /generatedImages/{imageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'prompt',
          'imageUrl',
          'model',
          'makerName',
          'createdAt'
        ])
          && request.resource.data.keys().hasOnly([
            'prompt',
            'imageUrl',
            'model',
            'makerName',
            'createdAt',
            'x',
            'y'
        ])
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() > 0
        && request.resource.data.prompt.size() <= 2000
        && request.resource.data.makerName is string
        && request.resource.data.makerName.size() > 0
        && request.resource.data.makerName.size() <= 80
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('^https://replicate\\.delivery/.*$')
        && request.resource.data.model == 'google/nano-banana-2'
        && request.resource.data.createdAt == request.time
        && request.resource.data.x is number
        && request.resource.data.x >= 0
        && request.resource.data.x <= 1
        && request.resource.data.y is number
        && request.resource.data.y >= 0
        && request.resource.data.y <= 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'x',
          'y'
        ])
        && request.resource.data.keys().hasAll(['x', 'y'])
        && request.resource.data.x is number
        && request.resource.data.x >= 0
        && request.resource.data.x <= 1
        && request.resource.data.y is number
        && request.resource.data.y >= 0
        && request.resource.data.y <= 1;
      allow delete: if false;
    }

    match /charadesPlayers/{playerId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.keys().hasOnly([
          'name',
          'score',
          'bestScore',
          'playing',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'score',
          'bestScore',
          'playing',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.name == request.auth.token.name.split(' ')[0]
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= request.resource.data.score
        && request.resource.data.bestScore <= 1000
        && request.resource.data.playing is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /charadesRounds/{roundId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'playerName',
          'target',
          'clues',
          'solved',
          'points',
          'resolution',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'playerName',
          'target',
          'clues',
          'solved',
          'points',
          'resolution',
          'createdAt'
        ])
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() > 0
        && request.resource.data.playerName.size() <= 40
        && request.resource.data.playerName == request.auth.token.name.split(' ')[0]
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 40
        && request.resource.data.clues is list
        && request.resource.data.clues.size() <= 8
        && request.resource.data.solved is bool
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 15
        && request.resource.data.resolution is int
        && request.resource.data.resolution >= 0
        && request.resource.data.resolution <= 10
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 100 (A05): profiles, two-person connections, posts and voice calls.
    match /hundredUsers/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'photo', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 1000;
    }

    // One document per pair; its ID is the two account IDs, sorted and joined by "_".
    match /hundredConnections/{pairId} {
      allow get, delete: if request.auth != null && request.auth.uid in pairId.split('_');
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create, update: if request.auth != null
        && request.auth.uid in pairId.split('_')
        && request.resource.data.members == pairId.split('_')
        && request.resource.data.keys().hasOnly([
          'members', 'profiles', 'status', 'requestedBy', 'startedDay', 'endedDay', 'messageDays', 'callDays', 'togetherDays'
        ])
        && request.resource.data.status in ['pending', 'active', 'ended'];

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in pairId.split('_');
        allow create: if request.auth != null
          && request.auth.uid in pairId.split('_')
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
      }
    }

    match /hundredPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'image', 'video', 'heat', 'commentCount', 'createdAt'])
        && request.resource.data.heat == {}
        && request.resource.data.commentCount == 0
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 900000
        && (request.resource.data.image == '' || request.resource.data.image.matches('^data:image/jpeg;base64,.*'))
        && request.resource.data.video is string
        && request.resource.data.video.size() <= 500
        && (request.resource.data.video == '' || request.resource.data.video.matches('^https://.*'))
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // Heat: each person can only add or remove their own entry ({ uid: name }).
      // Comments: the count can only go up by one, alongside a new comment.
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heat'])
          && request.resource.data.heat.diff(resource.data.get('heat', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.heat)
            || (request.resource.data.heat[request.auth.uid] is string
              && request.resource.data.heat[request.auth.uid].size() <= 40)))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1)
      );

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
      }
    }

    // Activities (watching, reading, studying): the host runs the room's shared state (playback or timer);
    // everyone, host included, can only add, update or remove their own entry under viewers.
    match /hundredActivities/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'type', 'host', 'hostName', 'title', 'service', 'url', 'items', 'timer', 'status', 'viewers', 'playback', 'hostSeenAt', 'startedAt'
        ])
        && request.resource.data.type in ['watching', 'reading', 'studying']
        && request.resource.data.title is string
        && (request.resource.data.title.size() > 0 || request.resource.data.type == 'watching')
        && request.resource.data.title.size() <= 80
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('^https://.*'))
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 10
        && request.resource.data.status == 'live'
        && request.resource.data.viewers.keys().hasOnly([request.auth.uid]);
      allow update: if request.auth != null && (
        (resource.data.host == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'title', 'playback', 'timer', 'hostSeenAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 80)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
          && request.resource.data.viewers.diff(resource.data.viewers).affectedKeys().hasOnly([request.auth.uid]))
      );

      match /chat/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
      }

      // Reading notes: a note on one article, with an optional quoted passage.
      match /notes/{noteId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'name', 'item', 'quote', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.item is int
          && request.resource.data.quote is string
          && request.resource.data.quote.size() <= 500
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
      }
    }

    match /hundredCalls/{callId} {
      allow get, update: if request.auth != null
        && request.auth.uid in [resource.data.from, resource.data.to];
      allow list: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.auth.uid in request.resource.data.connId.split('_')
        && request.resource.data.to in request.resource.data.connId.split('_');

      // ICE candidates for setting up the call.
      match /{side}/{candidateId} {
        allow read, create: if request.auth != null
          && request.auth.uid in [
            get(/databases/$(database)/documents/hundredCalls/$(callId)).data.from,
            get(/databases/$(database)/documents/hundredCalls/$(callId)).data.to
          ];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
